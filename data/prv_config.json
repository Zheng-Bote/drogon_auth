{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8860,
      "https": false
    }
  ],
  "app": {
    "number_of_threads": 1,
    "enable_session": true,
    "session_timeout": 0,
    "session_same_site": "Null",
    "session_cookie_key": "DROGON_AUTH_JSESSIONID",
    "session_max_age": -1,
    "document_root": "./public/html/",
    "home_page": "index.html",
    "use_implicit_page": true,
    "implicit_page": "index.html",
    "static_file_headers": [
      {
        "name": "field-name",
        "value": "field-value"
      }
    ],
    "upload_path": "../uploads",
    "file_types": [
      "avif",
      "bmp",
      "gif",
      "png",
      "jpg",
      "jpeg",
      "js",
      "css",
      "html",
      "ico",
      "swf",
      "xap",
      "apk",
      "cur",
      "xml",
      "webp",
      "svg"
    ],
    "log": {
      "use_spdlog": true,
      "log_path": "./data/logs/",
      "logfile_base_name": "drogon_auth",
      "log_size_limit": 10000000,
      "max_files": 100,
      "log_level": "DEBUG",
      "display_local_time": false
    },
    "use_gzip": true,
    "static_files_cache_time": 5,
    "server_header_field": "drogon auth",
    "enable_server_header": true,
    "gzip_static": true,
    "client_max_body_size": "1M",
    "client_max_memory_body_size": "64K",
    "client_max_websocket_message_size": "128K"
  },
  "plugins": [
    {
      "name": "drogon::plugin::AccessLogger",
      "dependencies": [],
      "config": {
        "use_spdlog": false,
        "log_path": "./data/logs/",
        "log_file": "drogon_auth_access.log",
        "log_size_limit": 10000000,
        "use_local_time": true,
        "log_index": 0,
        "use_real_ip": true
      }
    },
    {
      "name": "drogon::plugins::AuditLogPlugin",
      "config": {
        "db_client": "default"
      }
    }
  ]
}
